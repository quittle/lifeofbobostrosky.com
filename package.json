{
  "name": "lifeofbobostrosky.com",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "clean": "rm -rf ./dist && rm -rf ./dist-api",
    "react-build": "babel-node --extensions .js,.ts,.tsx react-build.ts src/js/index.ts dist/react-build.html dist/react-build.css dist/react-build.js src/App",
    "eslint": "eslint 'src/**' 'lambda/**' 'scripts/**/*.mts'",
    "eslint-fix": "eslint 'src/**' 'lambda/**' 'scripts/**/*.mts' --fix",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "lint": "npm run eslint && npm run prettier",
    "lint-fix": "npm run eslint-fix && npm run prettier-fix",
    "build": "npm run react-build && webpack",
    "build-serve": "./scripts/build-server",
    "build-prod": "npm run react-build && webpack --config config/webpack.prod.js",
    "build-apis": "webpack --config config/webpack.api.js",
    "deploy": "./scripts/deploy",
    "deploy-test": "./scripts/deploy test",
    "build-and-test": "npm run build && npm run build-prod && npm run build-apis && npm run lint",
    "release": "rm -rf ./dist && npm run build-prod && npm run build-apis && npm run deploy",
    "release-test": "rm -rf ./dist && npm run build-prod && npm run build-apis && npm run deploy-test",
    "download-data": "ts-node-esm ./scripts/download-data/index.mts"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/node": "^7.20.7",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@types/aws-lambda": "^8.10.110",
    "@types/aws-sdk": "^2.7.0",
    "@types/grecaptcha": "^3.0.4",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "@vue/preload-webpack-plugin": "^2.0.0",
    "axios": "^1.3.2",
    "babel-plugin-file-loader": "^2.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "css-minimizer-webpack-plugin": "^4.2.2",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-react": "^7.32.2",
    "file-loader": "^6.2.0",
    "file-type": "^18.2.0",
    "focus-trap": "^7.2.0",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jss": "^10.9.1",
    "mini-css-extract-plugin": "^2.7.2",
    "nodemon": "^2.0.20",
    "prettier": "^2.8.3",
    "react-dom": "^18.2.0",
    "react-jss": "^10.9.2",
    "s3-upload-custom-resource-lambda-layer": "^1.0.3",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1",
    "webpack-image-resize-loader": "^5.0.0",
    "webpack-merge": "^5.8.0"
  }
}
