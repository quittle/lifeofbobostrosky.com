    "@babel/preset-typescript": "^7.16.7",
    "@types/react": "^17.0.43",
    "html-loader": "^3.1.0",
    "html-webpack-plugin": "^5.5.0",
    "jss": "^10.9.0",
    "react-dom": "^18.0.0",
    "react-jss": "^10.9.0",
    "webpack": "^5.70.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4"
  }
}
