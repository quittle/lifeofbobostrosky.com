  "-type": "module",
  "scripts": {
    "react-build": "babel-node --extensions .js,.ts,.tsx react-build.ts dist/react-build.html src/App",
    "build": "npm run react-build && webpack",
    "build-serve-": "npm run react-build && npx webpack serve",
