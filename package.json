{
  "name": "bobostrosky.com",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "react-build": "babel-node --extensions .js,.ts,.tsx react-build.ts src/js/index.ts dist/react-build.html dist/react-build.css dist/react-build.js src/App",
    "eslint": "eslint 'src/**' 'lambda/**'",
    "eslint-fix": "eslint 'src/**' 'lambda/**' --fix",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "lint": "npm run eslint && npm run prettier",
    "lint-fix": "npm run eslint-fix && npm run prettier-fix",
    "build": "npm run react-build && webpack",
    "build-serve": "./scripts/build-server",
    "build-prod": "npm run react-build && webpack --config config/webpack.prod.js",
    "build-apis": "webpack --config config/webpack.api.js",
    "deploy": "./scripts/deploy",
    "build-and-test": "npm run build && npm run lint",
    "release": "rm -rf ./dist && npm run build-prod && npm run build-apis && npm run deploy"
  },
  "devDependencies": {
    "@babel/core": "^7.17.6",
    "@babel/node": "^7.16.8",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@types/aws-lambda": "^8.10.93",
    "@types/aws-sdk": "^2.7.0",
    "@types/react": "^17.0.43",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "@vue/preload-webpack-plugin": "^2.0.0",
    "axios": "^0.26.1",
    "copy-webpack-plugin": "^10.2.4",
    "css-loader": "^6.7.1",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "eslint": "^8.12.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.29.4",
    "html-loader": "^3.1.0",
    "html-webpack-plugin": "^5.5.0",
    "jss": "^10.9.0",
    "mini-css-extract-plugin": "^2.6.0",
    "prettier": "^2.6.1",
    "react-dom": "^18.0.0",
    "react-jss": "^10.9.0",
    "s3-upload-custom-resource-lambda-layer": "^1.0.3",
    "ts-loader": "^9.2.8",
    "typescript": "^4.6.3",
    "webpack": "^5.70.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@types/react-dom": "^17.0.14"
  }
}
